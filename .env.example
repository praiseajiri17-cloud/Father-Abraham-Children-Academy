# GEMINI_API_KEY: Required for Gemini AI API calls.
# AI Studio automatically injects this at runtime from user secrets.
# Users configure this via the Secrets panel in the AI Studio UI.
GEMINI_API_KEY="MY_GEMINI_API_KEY"

# APP_URL: The URL where this applet is hosted.
# AI Studio automatically injects this at runtime with the Cloud Run service URL.
# Used for self-referential links, OAuth callbacks, and API endpoints.
APP_URL="MY_APP_URL"

# -----------------------------------------------------------------------------
# PHASE 2: CLERK AUTHENTICATION (VITE FRONTEND + SERVER-SIDE)
# -----------------------------------------------------------------------------
# Public Publishable Key from Clerk Dashboard -> Configure -> API Keys.
# Safe to expose in Vite frontend bundles. Must start with pk_test_ or pk_live_.
VITE_CLERK_PUBLISHABLE_KEY=""

# Server-Side Secret Key (NEVER prefix with VITE_ and NEVER expose to browser).
# Reserved for Netlify Functions & server-side Clerk verification.
CLERK_SECRET_KEY=""

# -----------------------------------------------------------------------------
# PHASE 3: SUPABASE DATABASE & STORAGE (CLERK THIRD-PARTY AUTH INTEGRATION)
# -----------------------------------------------------------------------------
# Project URL from Supabase Dashboard -> Project Settings -> Data API
VITE_SUPABASE_URL=""

# Frontend-safe Publishable Key (or legacy anon key) from Supabase Dashboard -> API Keys.
# Safe for browser use when RLS is enforced. NEVER use service_role / secret key here.
VITE_SUPABASE_PUBLISHABLE_KEY=""

# Server-Side Supabase Secret / Service Role Key (NEVER prefix with VITE_).
# Reserved strictly for Netlify Functions and trusted backend workflows.
SUPABASE_SERVICE_ROLE_KEY=""

# Controlled server-side secret for one-time initial General Administrator provisioning
OWNER_BOOTSTRAP_SECRET=""

# Reserved for Phase 4+ Paystack server-side verification (NEVER prefix with VITE_)
PAYSTACK_SECRET_KEY=""
